{
  "name": "@24frame/dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ae:dry-run": "node scripts/agentic-engineering/dry-run.mjs",
    "governance:check:policy": "node scripts/governance/check.mjs && node --test scripts/governance/check.test.mjs && node --test scripts/governance/scan-secrets.test.mjs && node --test scripts/governance/notify-ci-exception.test.mjs && node --test scripts/security/lib/local-harness-config.test.mjs",
    "governance:archive-test": "PYTHONDONTWRITEBYTECODE=1 python3 -B scripts/governance/gitleaks-archive.test.py",
    "governance:check": "pnpm run governance:check:policy && pnpm run governance:archive-test",
    "governance:ci:scans": "node scripts/governance/scan-secrets.mjs --canary && node scripts/governance/scan-secrets.mjs --mode full-history",
    "governance": "pnpm run governance:check && node scripts/governance/scan-secrets.mjs --mode staged",
    "governance:ci": "pnpm run governance:check && pnpm run governance:ci:scans",
    "hygiene:bundle-grep": "node scripts/security/client-bundle-grep.mjs",
    "hygiene:bundle-report": "node scripts/hygiene/bundle-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^0.7.7",
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-dynamodb": "^3.1134.0",
    "@aws-sdk/client-mediaconvert": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1131.0",
    "@aws-sdk/cloudfront-signer": "^3.1088.0",
    "@aws-sdk/lib-dynamodb": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "@mux/mux-node": "^15.2.0",
    "@mux/mux-player-react": "^3.13.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@sentry/nextjs": "^10.75.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.10.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.103.1",
    "@upstash/redis": "^1.38.4",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "exceljs": "^4.4.0",
    "geist": "^1.6.1",
    "hls.js": "^1.7.3",
    "next": "16.3.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.5",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
