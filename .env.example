# Public values only — never commit a real .env. Copy to .env.local and fill in.

# Supabase (local: from `supabase status`; prod: project settings)
# Survivor project only (uevsculwzwlhxeamagwg). Dashboard and @24frame/mobile
# both read these two names — do not add a second project or donor Auth env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role. Never NEXT_PUBLIC_. Never a client bundle.
# Local: `supabase status`. Prod: project settings. Founder-set only.
SUPABASE_SERVICE_ROLE_KEY=

# Title / aggregation AWS (existing live names). Names only — never commit values.
# Dedicated title namespace. Never NEWS_S3_*. News thumbs reuse S3_BUCKET +
# CLOUDFRONT_DOMAIN (prefix news-thumbs/). Never fall back from FINANCE_AWS_* /
# MEDIA_AWS_* / EDUCATION_AWS_* / SES_AWS_* / NEWS_AWS_*. Never NEXT_PUBLIC_.
# See docs/infra/avatar-storage-setup.md and docs/infra/screener-proxy-setup.md.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_AVATARS_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=

# Cron + portal (aggregation). Names only. CRON_SECRET fail-closed in
# /api/cron handlers. PORTAL_BASE_URL is this app's own origin.
CRON_SECRET=
PORTAL_BASE_URL=

# Preview-only craft fixture on company-admin Dashboard. Set to 1 to show
# labeled sample data. Off unless env + staff/admin role. Never production
# statements. Never NEXT_PUBLIC_.
DASHBOARD_CRAFT_FIXTURE=

# Cloudflare Turnstile (signup queue hygiene, not the security boundary).
# Dev: Cloudflare's documented "always passes" test keys
#   site   = 1x00000000000000000000AA
#   secret = 1x0000000000000000000000000000000AA
# Prod: real keys from a Cloudflare Turnstile widget (FOUNDER TASK — do not invent).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (money-in: tier subscriptions + fees). TEST mode for dev; live keys are a launch task.
#   secret sk_test_... ; publishable pk_test_... (public);
#   webhook secret whsec_... from: stripe listen --forward-to localhost:3000/api/stripe/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ask Globee free-text operator. Founder sets ANTHROPIC_API_KEY in Vercel
# (Sensitive, Production and Preview only). Never commit a real value.
ANTHROPIC_API_KEY=

# 24Frame finance AWS (dedicated namespace). Names only — never commit values.
# Never fall back to AWS_* (titles) or MEDIA_AWS_* (social). Never NEXT_PUBLIC_.
# Live buckets: 24frame-finance-dev / 24frame-finance-prod.
# Production CloudFront is live; Preview stays S3 presign.
FINANCE_AWS_REGION=
FINANCE_AWS_ACCESS_KEY_ID=
FINANCE_AWS_SECRET_ACCESS_KEY=
S3_FINANCE_BUCKET=
FINANCE_CLOUDFRONT_DOMAIN=
FINANCE_CLOUDFRONT_KEY_PAIR_ID=
FINANCE_CLOUDFRONT_PRIVATE_KEY=

# Live Aurora clusters: frame-aurora-dev / frame-aurora-prod (us-west-2).
# App still uses survivor Postgres until Secure Compute + cutover.
# Auth stays Supabase. Never a survivor pooler URL. Never NEXT_PUBLIC_.
AURORA_DATABASE_URL=

# Finance worker interim SoT (survivor Postgres) until Aurora cutover.
# Prefer AURORA_DATABASE_URL when it is set and valid. Never put a
# survivor pooler URL in AURORA_DATABASE_URL — use this name instead.
FINANCE_DATABASE_URL=

# Auth transactional mail (SES us-west-2, verified 24frame.co).
# Magic link / OTP / verification only. Never AWS_* / FINANCE_AWS_* /
# MEDIA_AWS_*. Never NEXT_PUBLIC_. No Cognito.
# PORTAL_EMAIL_FROM must be @24frame.co; unset defaults to noreply@24frame.co.
SES_AWS_REGION=us-west-2
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
PORTAL_EMAIL_FROM=

# Residual Resend — GC-Support / asset notification mail only. Not Auth.
RESEND_API_KEY=
ASSETS_EMAIL_FROM=

# 24Frame Education AWS (dedicated source + output). Names only.
# Proposed buckets (not created — Adam confirm):
#   24frame-education-source-dev / 24frame-education-source-prod
#   24frame-education-output-dev / 24frame-education-output-prod
# Account hypothesis: 405912452061 (E8). Region hypothesis: us-west-2.
# Never fall back to AWS_* / FINANCE_AWS_* / MEDIA_AWS_* / SES_AWS_*.
# Never NEXT_PUBLIC_. CloudFront names empty on Preview → S3 presign
# (master only; relative HLS children unauthorized). Production HLS
# uses Education signed cookies + /api/education/hls. Never
# CLOUDFRONT_* / MEDIA_CLOUDFRONT_* / FINANCE_CLOUDFRONT_*.
EDUCATION_AWS_REGION=
EDUCATION_AWS_ACCESS_KEY_ID=
EDUCATION_AWS_SECRET_ACCESS_KEY=
S3_EDUCATION_SOURCE_BUCKET=
S3_EDUCATION_OUTPUT_BUCKET=
EDUCATION_MEDIACONVERT_ENDPOINT=
EDUCATION_MEDIACONVERT_ROLE_ARN=
EDUCATION_MEDIACONVERT_QUEUE_ARN=
EDUCATION_CLOUDFRONT_DOMAIN=
EDUCATION_CLOUDFRONT_KEY_PAIR_ID=
EDUCATION_CLOUDFRONT_PRIVATE_KEY=

# 24Frame Industry News AWS (DynamoDB). Names only — never commit values.
# Proposed tables (not created — founder apply): 24frame-news-dev / 24frame-news-prod.
# Account 405912452061 / us-west-2. Never fall back to AWS_* / FINANCE_AWS_* /
# MEDIA_AWS_* / SES_AWS_* / EDUCATION_AWS_*. Never NEXT_PUBLIC_.
# No Vercel cron. Ingest is Lambda + EventBridge. See docs/infra/news-aws-setup.md.
NEWS_AWS_REGION=us-west-2
NEWS_AWS_ACCESS_KEY_ID=
NEWS_AWS_SECRET_ACCESS_KEY=
NEWS_DDB_TABLE=
# Optional ingest OG HTML cap in bytes. Default 1500000. Server-only. Never NEXT_PUBLIC_.
NEWS_OG_MAX_BYTES=
# Thumb mirror reuses title S3_BUCKET + AWS_REGION + CLOUDFRONT_DOMAIN
# (prefix news-thumbs/). No NEWS_S3_*. Dynamo credentials stay NEWS_AWS_*.

# Sentry (errors + performance). Same DSN value for both names. Leave empty
# locally to no-op. Never commit a real DSN. Existing project only:
# org e8-holdings-llc / project 24frame (US). Set on Vercel Production and
# Preview. Source-map upload is not wired — do not set SENTRY_AUTH_TOKEN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=e8-holdings-llc
SENTRY_PROJECT=24frame

# Social hot cache (Upstash Redis REST). Server-only. Never NEXT_PUBLIC_.
# Optional locally and in CI — missing env falls through to Supabase.
# Vercel Marketplace / KV injects KV_REST_API_URL + KV_REST_API_TOKEN
# (and often KV_URL redis://). Classic names also work. Prefer KV_* REST.
# KV_URL is not a REST URL — do not point the client at it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Social Mux Video — API tokens already set on Vercel 24frame.
# Signing key id + base64 PEM are the official Mux JWT names
# (mux.jwt.signPlaybackId). Server-only. Never NEXT_PUBLIC_.
# Agents do not set values. Founder sets the signing pair.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# Social music scan (ACRCloud identify). Names only. Server-only.
# Lambda env, not the browser. Never NEXT_PUBLIC_. Never commit values.
# ACRCLOUD_HOST is the identify hostname, not a URL.
# See docs/infra/social-music-detect.md.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
